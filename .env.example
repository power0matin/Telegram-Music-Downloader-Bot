# ============================
# Telegram Music Downloader Bot
# Environment configuration
# ============================

# (الزامی) توکن ربات تلگرام
# از @BotFather بگیر
BOT_TOKEN=123456789:ABCDEF_your_real_token_here

# ----------------------------
# مسیرها (اختیاری، ولی توصیه می‌شود)
# ----------------------------

# فولدر دانلودها (اگر خالی بگذاری، به صورت پیش‌فرض ./downloads استفاده می‌شود)
DOWNLOAD_DIR=./downloads

# مسیر فایل صف دانلود
QUEUE_PATH=./queue/queue.json

# ----------------------------
# تنظیمات ریت‌لیمیت (اختیاری)
# ----------------------------

# حداکثر تعداد درخواست مجاز در هر بازه
# مقدار پیش‌فرض در کد: 20
RATE_LIMIT_REQUESTS=20

# طول بازه‌ی ریت‌لیمیت (برحسب ثانیه)
# مقدار پیش‌فرض در کد: 60
RATE_LIMIT_WINDOW_SECONDS=60

# ----------------------------
# تنظیمات دانلود (اختیاری)
# ----------------------------

# کیفیت پیش‌فرض (kbps)
# مقدار پیش‌فرض در کد: 320
DEFAULT_QUALITY=320

# حداکثر حجم فایل دانلود (به مگابایت)
# مقدار پیش‌فرض در کد: 50
MAX_DOWNLOAD_SIZE_MB=50

# ----------------------------
# لاگ و زبان (اختیاری)
# ----------------------------

# سطح لاگ: DEBUG, INFO, WARNING, ERROR
# مقدار پیش‌فرض در کد: INFO
LOG_LEVEL=INFO

# زبان پیش‌فرض بات: en یا fa
# مقدار پیش‌فرض در کد: en
DEFAULT_LANGUAGE=fa

# ----------------------------
# منابع دانلود موزیک (اختیاری)
# ----------------------------

# ترتیب fallback بین منابع صوتی. پیش‌فرض از SoundCloud شروع می‌شه چون هیچ
# مشکل بلاک ربات نداره و بدون هیچ تنظیمات اضافه (کوکی/پروکسی) روی هر سروری کار می‌کنه.
# اگه یوتیوب رو هم می‌خوای به عنوان fallback نگه داری همینو دست نزن؛ برای بعضی
# ترک‌ها که فقط رو یوتیوبن ممکنه گاهی AudioProviderError بگیری (طبیعیه، نیازی
# به کاری نیست، چون ترتیب SoundCloud اول امتحان میشه).
AUDIO_PROVIDERS=soundcloud,youtube-music,youtube

# ----------------------------
# گزینه‌های پیشرفته یوتیوب (اختیاری - لازم نیست پر کنی، فقط اگه خواستی دقت
# روی یوتیوب رو بالا ببری)
# ----------------------------

# پروکسی برای دور زدن بلاک آی‌پی دیتاسنتر روی درخواست‌های یوتیوب.
PROXY_URL=

# مسیر فایل کوکی export شده از یک سشن لاگین‌شده یوتیوب.
COOKIE_FILE=

# آرگومان‌های اضافه‌ای که مستقیم به yt-dlp پاس داده میشه.
YTDLP_EXTRA_ARGS=
