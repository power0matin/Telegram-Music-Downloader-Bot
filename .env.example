# =====================================
# 🎵 Spotify Downloader Bot Configuration
# =====================================

# Required: Your Telegram Bot Token
# Get this from @BotFather on Telegram
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=your_bot_token_here

# Optional: Default audio quality (128 or 320 kbps)
# 128 = smaller files, faster downloads
# 320 = higher quality, larger files
DEFAULT_QUALITY=320

# Optional: Maximum download retries on failure
MAX_RETRIES=5

# Optional: Initial retry delay in seconds (will increase exponentially)
RETRY_DELAY=5

# Optional: Download timeout in seconds
DOWNLOAD_TIMEOUT=300

# Optional: Enable debug logging (true/false)
DEBUG_MODE=false

# =====================================
# How to use this file:
# 1. Copy this file to .env
# 2. Replace 'your_bot_token_here' with your actual bot token
# 3. Adjust other settings as needed
# 4. Keep this file secure and never share your bot token!
# =====================================