# Telegram Music Downloader Bot configuration

# Required: token from @BotFather
BOT_TOKEN=123456789:ABCDEF_your_bot_token_here

# Runtime paths
DOWNLOAD_DIR=./downloads
QUEUE_PATH=./queue/queue.json

# Abuse/resource limits
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_DOWNLOADS=3

# Download and Telegram upload settings
DEFAULT_QUALITY=320
MAX_DOWNLOAD_SIZE_MB=50
DOWNLOAD_TIMEOUT_SECONDS=900
UPLOAD_TIMEOUT_SECONDS=180
UPLOAD_RETRIES=3

# Logging and UI language: en or fa
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=fa

# spotDL 4.5.x audio-provider fallback order.
# Supported: youtube, youtube-music, soundcloud, bandcamp, piped
AUDIO_PROVIDERS=soundcloud,youtube-music,youtube

# Optional yt-dlp reliability settings
PROXY_URL=
COOKIE_FILE=
YTDLP_EXTRA_ARGS=
